# Bu dosyayı kopyalayıp .env olarak adlandırın ve gerçek değerleri girin.
# .env dosyasını asla GitHub'a yüklemeyin!

# Flask Gizli Anahtarı (güçlü ve rastgele bir değer girin)
SECRET_KEY=cok-gizli-bir-anahtar-buraya-yazin

# Flask Ortamı: development veya production
FLASK_ENV=development
FLASK_DEBUG=True

# Firebase Servis Hesabı JSON Dosyasının Yolu
# Dosyayı proje köküne koyun, ismi .gitignore'da hariç tutulacak şekilde ayarlayın
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
